#!/usr/bin/env bash

set -euo pipefail

FACTORY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage:
  ./factory doctor
  ./factory create <project-name> [--type <website-type>]
  ./factory intake <project-name>
  ./factory list
  ./factory status <project-name>
  ./factory validate-brief <project-name>
  ./factory validate-stage <project-name>
  ./factory validate-release <project-name>
  ./factory next <project-name>
  ./factory handoff <project-name>
  ./factory advance <project-name>
  ./factory approve <project-name> APPROVED
  ./factory deploy <project-name> --dry-run
  ./factory deploy <project-name> --confirm DEPLOY
  ./factory rollback <project-name> <deployment-id-or-url> --dry-run
  ./factory rollback <project-name> <deployment-id-or-url> --confirm ROLLBACK
  ./factory preview <project-name> [port]
  ./factory frontend [port]
  ./factory buy-domain <project-name> <domain> --dry-run
  ./factory buy-domain <project-name> <domain> --confirm PURCHASE --expected-price <price>
  ./factory scan-secrets [project-name]
  ./factory check <project-name>
  ./factory test

Examples:
  ./factory doctor
  ./factory create client-website
  ./factory create client-website --type restaurant
  ./factory intake client-website
  ./factory list
  ./factory status factory-demo
  ./factory validate-brief factory-demo
  ./factory validate-stage factory-demo
  ./factory validate-release client-website
  ./factory next factory-demo
  ./factory handoff client-website
  ./factory advance client-website
  ./factory approve client-website APPROVED
  ./factory deploy client-website --dry-run
  ./factory deploy client-website --confirm DEPLOY
  ./factory rollback client-website dpl_previousDeployment --dry-run
  ./factory rollback client-website dpl_previousDeployment --confirm ROLLBACK
  ./factory preview factory-demo
  ./factory preview factory-demo 9000
  ./factory frontend
  ./factory frontend 5000
  ./factory buy-domain client-website example.com --dry-run
  ./factory buy-domain client-website example.com --confirm PURCHASE --expected-price 12.99
  ./factory scan-secrets
  ./factory scan-secrets factory-demo
  ./factory check factory-demo
  ./factory test
EOF
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

validate_project_name() {
  if ! [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; then
    fail "project name must start with a letter or number and contain only letters, numbers, hyphens, and underscores."
  fi
}

prepare_project_directory() {
  PROJECT_NAME="$1"
  validate_project_name "$PROJECT_NAME"

  PROJECT_DIR="$FACTORY_ROOT/projects/$PROJECT_NAME"
  [ -d "$PROJECT_DIR" ] || fail "project '$PROJECT_NAME' does not exist in $FACTORY_ROOT/projects."
}

prepare_site() {
  prepare_project_directory "$1"

  SITE_DIR="$PROJECT_DIR/src"
  [ -d "$SITE_DIR" ] || fail "project '$PROJECT_NAME' has no src directory."
  [ -f "$SITE_DIR/index.html" ] || fail "project '$PROJECT_NAME' has no src/index.html entry page."
}

COMMAND="${1:-}"

case "$COMMAND" in
  doctor)
    if [ "$#" -ne 1 ]; then
      usage >&2
      exit 1
    fi

    command -v python3 >/dev/null 2>&1 || fail "python3 is required to inspect factory health."
    DOCTOR="$FACTORY_ROOT/tools/factory-doctor.py"
    [ -f "$DOCTOR" ] || fail "factory doctor is missing at $DOCTOR."

    exec python3 "$DOCTOR"
    ;;
  create)
    WEBSITE_TYPE=""
    if [ "$#" -eq 4 ] && [ "$3" = "--type" ]; then
      WEBSITE_TYPE="$4"
    elif [ "$#" -ne 2 ]; then
      usage >&2
      exit 1
    fi

    validate_project_name "$2"
    INITIALIZER="$FACTORY_ROOT/tools/init-project.sh"
    [ -x "$INITIALIZER" ] || fail "project initializer is missing or not executable at $INITIALIZER."

    exec "$INITIALIZER" "$2" "$WEBSITE_TYPE"
    ;;
  intake)
    if [ "$#" -ne 2 ]; then
      usage >&2
      exit 1
    fi

    prepare_project_directory "$2"
    command -v python3 >/dev/null 2>&1 || fail "python3 is required to guide project intake."
    INTAKE_TOOL="$FACTORY_ROOT/tools/project-intake.py"
    [ -f "$INTAKE_TOOL" ] || fail "project intake tool is missing at $INTAKE_TOOL."

    exec python3 "$INTAKE_TOOL" "$PROJECT_NAME" "$PROJECT_DIR"
    ;;
  list)
    if [ "$#" -ne 1 ]; then
      usage >&2
      exit 1
    fi

    command -v python3 >/dev/null 2>&1 || fail "python3 is required to list projects."
    STATUS_TOOL="$FACTORY_ROOT/tools/project-status.py"
    [ -f "$STATUS_TOOL" ] || fail "project status tool is missing at $STATUS_TOOL."

    exec python3 "$STATUS_TOOL" list "$FACTORY_ROOT/projects"
    ;;
  status)
    if [ "$#" -ne 2 ]; then
      usage >&2
      exit 1
    fi

    prepare_project_directory "$2"
    command -v python3 >/dev/null 2>&1 || fail "python3 is required to show project status."
    STATUS_TOOL="$FACTORY_ROOT/tools/project-status.py"
    [ -f "$STATUS_TOOL" ] || fail "project status tool is missing at $STATUS_TOOL."

    exec python3 "$STATUS_TOOL" show "$PROJECT_NAME" "$PROJECT_DIR"
    ;;
  validate-brief)
    if [ "$#" -ne 2 ]; then
      usage >&2
      exit 1
    fi

    prepare_project_directory "$2"
    command -v python3 >/dev/null 2>&1 || fail "python3 is required to validate a project brief."

    BRIEF_VALIDATOR="$FACTORY_ROOT/tools/validate-brief.py"
    BRIEF_FILE="$PROJECT_DIR/PROJECT-BRIEF.md"
    [ -f "$BRIEF_VALIDATOR" ] || fail "project brief validator is missing at $BRIEF_VALIDATOR."
    [ -f "$BRIEF_FILE" ] || fail "project '$PROJECT_NAME' has no PROJECT-BRIEF.md file."

    exec python3 "$BRIEF_VALIDATOR" "$PROJECT_NAME" "$BRIEF_FILE"
    ;;
  validate-stage)
    if [ "$#" -ne 2 ]; then
      usage >&2
      exit 1
    fi

    prepare_project_directory "$2"
    command -v python3 >/dev/null 2>&1 || fail "python3 is required to validate a project stage."

    STAGE_VALIDATOR="$FACTORY_ROOT/tools/validate-stage.py"
    [ -f "$STAGE_VALIDATOR" ] || fail "project stage validator is missing at $STAGE_VALIDATOR."

    exec python3 "$STAGE_VALIDATOR" "$PROJECT_NAME" "$PROJECT_DIR"
    ;;
  validate-release)
    if [ "$#" -ne 2 ]; then
      usage >&2
      exit 1
    fi

    prepare_project_directory "$2"
    command -v python3 >/dev/null 2>&1 || fail "python3 is required to validate release readiness."

    RELEASE_VALIDATOR="$FACTORY_ROOT/tools/validate-release.py"
    [ -f "$RELEASE_VALIDATOR" ] || fail "release validator is missing at $RELEASE_VALIDATOR."

    exec python3 "$RELEASE_VALIDATOR" "$PROJECT_NAME" "$PROJECT_DIR"
    ;;
  next|handoff|advance)
    if [ "$#" -ne 2 ]; then
      usage >&2
      exit 1
    fi

    prepare_project_directory "$2"
    command -v python3 >/dev/null 2>&1 || fail "python3 is required to control project workflow."

    WORKFLOW_CONTROLLER="$FACTORY_ROOT/tools/workflow-controller.py"
    [ -f "$WORKFLOW_CONTROLLER" ] || fail "workflow controller is missing at $WORKFLOW_CONTROLLER."

    exec python3 "$WORKFLOW_CONTROLLER" "$COMMAND" "$PROJECT_NAME" "$PROJECT_DIR"
    ;;
  approve)
    if [ "$#" -ne 3 ]; then
      usage >&2
      exit 1
    fi

    prepare_project_directory "$2"
    command -v python3 >/dev/null 2>&1 || fail "python3 is required to record human approval."

    WORKFLOW_CONTROLLER="$FACTORY_ROOT/tools/workflow-controller.py"
    [ -f "$WORKFLOW_CONTROLLER" ] || fail "workflow controller is missing at $WORKFLOW_CONTROLLER."

    exec python3 "$WORKFLOW_CONTROLLER" approve "$PROJECT_NAME" "$PROJECT_DIR" "$3"
    ;;
  deploy)
    if [ "$#" -eq 3 ] && [ "$3" = "--dry-run" ]; then
      DEPLOY_MODE="dry-run"
    elif [ "$#" -eq 4 ] && [ "$3" = "--confirm" ]; then
      DEPLOY_MODE="deploy"
    else
      usage >&2
      exit 1
    fi

    prepare_project_directory "$2"
    command -v python3 >/dev/null 2>&1 || fail "python3 is required to control deployments."

    DEPLOYER="$FACTORY_ROOT/tools/deployment-adapter.py"
    [ -f "$DEPLOYER" ] || fail "deployment adapter is missing at $DEPLOYER."

    if [ "$DEPLOY_MODE" = "dry-run" ]; then
      exec python3 "$DEPLOYER" dry-run "$PROJECT_NAME" "$PROJECT_DIR"
    fi
    exec python3 "$DEPLOYER" deploy "$PROJECT_NAME" "$PROJECT_DIR" "$4"
    ;;
  rollback)
    if [ "$#" -eq 4 ] && [ "$4" = "--dry-run" ]; then
      ROLLBACK_MODE="rollback-dry-run"
    elif [ "$#" -eq 5 ] && [ "$4" = "--confirm" ]; then
      ROLLBACK_MODE="rollback"
    else
      usage >&2
      exit 1
    fi

    prepare_project_directory "$2"
    command -v python3 >/dev/null 2>&1 || fail "python3 is required to control rollbacks."

    DEPLOYER="$FACTORY_ROOT/tools/deployment-adapter.py"
    [ -f "$DEPLOYER" ] || fail "deployment adapter is missing at $DEPLOYER."

    if [ "$ROLLBACK_MODE" = "rollback-dry-run" ]; then
      exec python3 "$DEPLOYER" rollback-dry-run "$PROJECT_NAME" "$PROJECT_DIR" "$3"
    fi
    exec python3 "$DEPLOYER" rollback "$PROJECT_NAME" "$PROJECT_DIR" "$3" "$5"
    ;;
  preview)
    if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
      usage >&2
      exit 1
    fi

    prepare_site "$2"
    PORT="${3:-8743}"

    case "$PORT" in
      ''|*[!0-9]*) fail "port must be a number from 1 to 65535." ;;
    esac

    if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
      fail "port must be a number from 1 to 65535."
    fi

    command -v python3 >/dev/null 2>&1 || fail "python3 is required to run a local preview."

    PREVIEW_SERVER="$FACTORY_ROOT/tools/preview-server.py"
    [ -f "$PREVIEW_SERVER" ] || fail "preview server is missing at $PREVIEW_SERVER."

    printf 'Previewing %s at http://127.0.0.1:%s/\n' "$PROJECT_NAME" "$PORT"
    printf 'Press Ctrl-C to stop.\n'

    exec python3 "$PREVIEW_SERVER" --port "$PORT" --bind 127.0.0.1 --directory "$SITE_DIR"
    ;;
  frontend)
    if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
      usage >&2
      exit 1
    fi

    FRONTEND_DIR="$FACTORY_ROOT/frontend"
    [ -d "$FRONTEND_DIR" ] || fail "frontend directory is missing at $FRONTEND_DIR."

    PORT="${2:-5173}"

    case "$PORT" in
      ''|*[!0-9]*) fail "port must be a number from 1 to 65535." ;;
    esac

    if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
      fail "port must be a number from 1 to 65535."
    fi

    command -v python3 >/dev/null 2>&1 || fail "python3 is required to run the local backend."

    BACKEND_SERVER="$FACTORY_ROOT/tools/local_backend.py"
    [ -f "$BACKEND_SERVER" ] || fail "local backend is missing at $BACKEND_SERVER."

    printf 'Serving the frontend prototype and its local backend at http://127.0.0.1:%s/\n' "$PORT"
    printf 'Health check: http://127.0.0.1:%s/api/health\n' "$PORT"
    printf 'Press Ctrl-C to stop.\n'

    exec python3 "$BACKEND_SERVER" --port "$PORT" --bind 127.0.0.1 --frontend-dir "$FRONTEND_DIR" --projects-dir "$FACTORY_ROOT/projects"
    ;;
  buy-domain)
    command -v python3 >/dev/null 2>&1 || fail "python3 is required to check or buy a domain."
    DOMAIN_ADAPTER="$FACTORY_ROOT/tools/domain-adapter.py"
    [ -f "$DOMAIN_ADAPTER" ] || fail "domain adapter is missing at $DOMAIN_ADAPTER."

    if [ "$#" -eq 4 ] && [ "$4" = "--dry-run" ]; then
      exec python3 "$DOMAIN_ADAPTER" dry-run "$2" "$3"
    fi

    if [ "$#" -eq 7 ] && [ "$4" = "--confirm" ] && [ "$6" = "--expected-price" ]; then
      exec python3 "$DOMAIN_ADAPTER" buy "$2" "$3" "$5" "$7"
    fi

    printf 'Usage:\n' >&2
    printf '  ./factory buy-domain <project-name> <domain> --dry-run\n' >&2
    printf '  ./factory buy-domain <project-name> <domain> --confirm PURCHASE --expected-price <price>\n' >&2
    exit 1
    ;;
  scan-secrets)
    if [ "$#" -gt 2 ]; then
      usage >&2
      exit 1
    fi

    command -v python3 >/dev/null 2>&1 || fail "python3 is required to scan for secrets."
    SCANNER="$FACTORY_ROOT/tools/secret_scan.py"
    [ -f "$SCANNER" ] || fail "secret scanner is missing at $SCANNER."

    if [ "$#" -eq 1 ]; then
      exec python3 "$SCANNER"
    fi

    if [ "$2" = "." ]; then
      exec python3 "$SCANNER" .
    fi

    validate_project_name "$2"
    exec python3 "$SCANNER" "$2"
    ;;
  check)
    if [ "$#" -ne 2 ]; then
      usage >&2
      exit 1
    fi

    prepare_site "$2"
    command -v python3 >/dev/null 2>&1 || fail "python3 is required to check a project."

    CHECKER="$FACTORY_ROOT/tools/check-project.py"
    [ -f "$CHECKER" ] || fail "project checker is missing at $CHECKER."

    exec python3 "$CHECKER" "$PROJECT_NAME" "$SITE_DIR"
    ;;
  test)
    if [ "$#" -ne 1 ]; then
      usage >&2
      exit 1
    fi

    command -v python3 >/dev/null 2>&1 || fail "python3 is required to test the factory."

    TEST_RUNNER="$FACTORY_ROOT/tools/test-factory.py"
    [ -f "$TEST_RUNNER" ] || fail "factory test runner is missing at $TEST_RUNNER."

    exec python3 "$TEST_RUNNER"
    ;;
  help|-h|--help)
    usage
    ;;
  '')
    usage >&2
    exit 1
    ;;
  *)
    fail "unknown command '$COMMAND'. Run './factory --help' for usage."
    ;;
esac
