<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$page_title &mdash; $business_name</title>
<meta name="description" content="$meta_description">
<meta name="robots" content="noindex, nofollow">
<style>
  :root {
    --paper: $color_paper;
    --ink: $color_ink;
    --accent: $color_accent;
    --band: $color_band;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.6;
  }
  .skip-link {
    position: absolute; left: -9999px; top: 0; background: var(--accent); color: #fff;
    padding: 10px 16px; z-index: 10;
  }
  .skip-link:focus { left: 12px; top: 12px; }
  .container { max-width: 960px; margin: 0 auto; padding: 0 20px; }
  header.site-header { padding: 20px 0; border-bottom: 1px solid color-mix(in srgb, var(--ink) 12%, transparent); }
  .wordmark { font-weight: 700; font-size: 1.25rem; color: var(--ink); text-decoration: none; }
  .draft-banner {
    background: var(--band); color: var(--ink); font-size: 0.85rem; text-align: center;
    padding: 8px 16px;
  }
  nav.site-nav { display: flex; gap: 18px; margin-top: 4px; flex-wrap: wrap; }
  nav.site-nav a { color: var(--ink); text-decoration: none; font-size: 0.9rem; }
  nav.site-nav a:hover { text-decoration: underline; }
  nav.site-nav .nav-current { color: var(--accent); font-size: 0.9rem; font-weight: 650; }
  .page-hero { padding: 64px 0 48px; }
  h1 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); line-height: 1.15; margin: 0 0 20px; }
  .page-hero p.lede { font-size: 1.1rem; max-width: 60ch; margin: 0; }
  footer.site-footer {
    padding: 32px 0; font-size: 0.85rem; color: color-mix(in srgb, var(--ink) 65%, transparent);
    border-top: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
</style>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="draft-banner">AI-drafted pilot &mdash; business facts and claims are unverified. Review before publishing.</div>
<header class="site-header"><div class="container">
  <span class="wordmark">$business_name</span>
  <nav class="site-nav" aria-label="Primary">$nav_html</nav>
</div></header>

<main id="main-content">
  <section class="page-hero"><div class="container">
    <h1>$page_title</h1>
    <p class="lede">$page_body</p>
  </div></section>
</main>

<footer class="site-footer"><div class="container">
  <p>$business_name &mdash; local AI-generated draft. No claims here are verified. Generated $generated_at by the AI Website Factory.</p>
</div></footer>
</body>
</html>
