<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$business_name</title>
<meta name="description" content="$meta_description">
<meta name="robots" content="noindex, nofollow">
<style>
  :root {
    --paper: $color_paper;
    --ink: $color_ink;
    --accent: $color_accent;
    --band: $color_band;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.6;
  }
  .skip-link {
    position: absolute; left: -9999px; top: 0; background: var(--accent); color: #fff;
    padding: 10px 16px; z-index: 10;
  }
  .skip-link:focus { left: 12px; top: 12px; }
  .container { max-width: 960px; margin: 0 auto; padding: 0 20px; }
  header.site-header { padding: 20px 0; border-bottom: 1px solid color-mix(in srgb, var(--ink) 12%, transparent); }
  .wordmark { font-weight: 700; font-size: 1.25rem; color: var(--ink); text-decoration: none; }
  .draft-banner {
    background: var(--band); color: var(--ink); font-size: 0.85rem; text-align: center;
    padding: 8px 16px;
  }
  .hero { padding: 64px 0 48px; }
  .eyebrow {
    text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; font-weight: 700;
    color: var(--accent); margin: 0 0 12px;
  }
  h1 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; margin: 0 0 16px; }
  .hero p.lede { font-size: 1.15rem; max-width: 60ch; margin: 0 0 24px; }
  .button {
    display: inline-block; padding: 12px 24px; border-radius: 8px; font-weight: 650;
    text-decoration: none; background: var(--accent); color: #fff; border: none; cursor: default;
  }
  section.services { padding: 48px 0; background: var(--band); }
  .service-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-top: 24px; }
  .service-card { background: var(--paper); border-radius: 12px; padding: 20px; }
  .service-card h3 { margin: 0 0 8px; }
  .service-card .price { font-size: 0.9rem; color: color-mix(in srgb, var(--ink) 65%, transparent); }
  .close-band { padding: 48px 0; text-align: center; }
  .planned-pages { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .planned-pages span {
    font-size: 0.8rem; padding: 4px 10px; border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
  }
  footer.site-footer {
    padding: 32px 0; font-size: 0.85rem; color: color-mix(in srgb, var(--ink) 65%, transparent);
    border-top: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
</style>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="draft-banner">AI-drafted pilot &mdash; business facts and claims are unverified. Review before publishing.</div>
<header class="site-header"><div class="container"><span class="wordmark">$business_name</span></div></header>

<main id="main-content">
  <section class="hero"><div class="container">
    <p class="eyebrow">$kicker</p>
    <h1>$title</h1>
    <p class="lede">$body</p>
    <span class="button">$cta_label</span>
  </div></section>

$services_section

  <section class="close-band"><div class="container">
    <h2>$close_title</h2>
    <p>$close_note</p>
    <p class="planned-pages-label">Planned pages (not yet built):</p>
    <div class="planned-pages">$planned_pages_html</div>
  </div></section>
</main>

<footer class="site-footer"><div class="container">
  <p>$business_name &mdash; local AI-generated draft. No claims here are verified. Generated $generated_at by the AI Website Factory.</p>
</div></footer>
</body>
</html>
