# AI Website Factory — environment template
# Copy to `.env` and fill in local values. Never commit `.env`.

# Optional: Upstash Redis for Next.js API / AI generation rate limiting
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Required for ./factory frontend's real POST /api/generate route (see
# tools/local_backend.py and frontend/README.md). Without it, that route
# fails closed with a clear 503 rather than fabricating copy.
ANTHROPIC_API_KEY=sk-ant-replace-with-anthropic-key

# Optional: used only by projects that add a backend
DATABASE_URL=postgresql://user:password@localhost:5432/replace-with-database-name
AUTH_SECRET=replace-with-at-least-32-character-random-string
EMAIL_API_KEY=replace-with-email-provider-key
OPENAI_API_KEY=sk-replace-with-openai-key
