# AI Website Factory — environment template
# Copy to `.env` and fill in local values. Never commit `.env`.

# Optional: Upstash Redis for Next.js API / AI generation rate limiting
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Required for ./factory frontend's real POST /api/generate route (see
# tools/local_backend.py and frontend/README.md). Without it, that route
# fails closed with a clear 503 rather than fabricating copy.
ANTHROPIC_API_KEY=sk-ant-replace-with-anthropic-key

# Required for real domain availability/price checks (GET /api/domains/check)
# and for ./factory buy-domain (tools/domain-adapter.py). Create at
# https://vercel.com/account/tokens. VERCEL_TEAM_ID is only needed if the
# domain should be registered under a team rather than your personal account.
VERCEL_TOKEN=replace-with-vercel-access-token
VERCEL_TEAM_ID=

# Required for real one-time export checkout (POST /api/checkout), via
# Square's hosted Checkout API — this app never handles card data itself.
# Get these from the Square Developer Dashboard (developer.squareup.com).
# SQUARE_ENVIRONMENT defaults to "sandbox" (test mode, no real charges) if
# unset; set it to "production" only when you intend to accept real payments,
# and only with a production access token (sandbox and production
# credentials are not interchangeable — Square rejects a mismatched pair).
SQUARE_ACCESS_TOKEN=replace-with-square-access-token
SQUARE_LOCATION_ID=replace-with-square-location-id
SQUARE_ENVIRONMENT=sandbox

# Optional: used only by projects that add a backend
DATABASE_URL=postgresql://user:password@localhost:5432/replace-with-database-name
AUTH_SECRET=replace-with-at-least-32-character-random-string
EMAIL_API_KEY=replace-with-email-provider-key
OPENAI_API_KEY=sk-replace-with-openai-key
